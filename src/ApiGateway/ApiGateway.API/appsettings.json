{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {
      "CampusRoute": {
        "ClusterId": "CampusCluster",
        "Match": {
          "Path": "/api/campus/{**catch-all}"
        }
      },
      "IdentityRoute": {
        "ClusterId": "IdentityCluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "IncidentRoute": {
        "ClusterId": "IncidentCluster",
        "Match": {
          "Path": "/api/incident/{**catch-all}"
        }
      },
      "ScheduleRoute": {
        "ClusterId": "ScheduleCluster",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        }
      }
    },


    "Clusters": {
      "CampusCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://campus-api:80"
          }
        }
      },
      "IdentityCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://identity-api:80"          }
        }
      },
      "IncidentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://incident-api:80"
          }
        }
      },
      "ScheduleCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://schedule-api:80"
          }
        }
      }
    }
  }
}
