## Ignore Visual Studio temporary files, build results, and IDE files

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Rider
.idea/

# VS Code
.vscode/

# Mac / Linux OS files
.DS_Store
Thumbs.db

# Testing
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
[Tt]est[Rr]esults/

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Environments / Secrets
appsettings.Development.json
appsettings.local.json
.env

# Docker
docker-compose.override.yml
.dockerignore

# Frontend (if added later)
node_modules/
dist/
build/

# Directorio espurio generado por las EF Core tools en macOS/Linux
bin\\Debug/
